{
  "name": "feiyu-brain",
  "version": "1.2.0",
  "description": "大肥鱼的大脑内核：人设是根，情绪/记忆/意识流/归因都是从人设长出来的。DSH 插件 + 平台无关库。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangqiuci/feiyu-brain.git"
  },
  "homepage": "https://github.com/fangqiuci/feiyu-brain#readme",
  "bugs": {
    "url": "https://github.com/fangqiuci/feiyu-brain/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/dsh-plugin.mjs",
  "exports": {
    ".": "./lib/dsh-plugin.mjs",
    "./lib": "./lib/dsh-plugin.mjs",
    "./adapters": "./adapters/index.js",
    "./adapters/qq-bridge": "./adapters/qq-bridge.js",
    "./adapters/tencent-official": "./adapters/tencent-official.js",
    "./adapters/universal": "./adapters/universal.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "feiyu": "./cli.mjs"
  },
  "files": [
    "index.js",
    "store.js",
    "cli.mjs",
    "demo.mjs",
    "selftest.mjs",
    "cordis.patch.yml",
    "core/",
    "adapters/",
    "lib/",
    "docs/",
    "examples/",
    "market/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "llm",
    "agent",
    "persona",
    "memory",
    "brain",
    "qq-bot",
    "tencent-qq",
    "chatbot"
  ],
  "scripts": {
    "test": "node selftest.mjs && node test-adapters.mjs",
    "demo": "node demo.mjs",
    "smoke": "node smoke.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
