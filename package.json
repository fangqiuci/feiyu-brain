{
  "name": "feiyu-brain",
  "version": "1.6.3",
  "description": "给 AI 装一颗有记忆、有情绪、会变化的脑；带上嘴（外接 OneBot/官方）和手（点、打、滑、执行）。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangqiuci/feiyu-brain.git"
  },
  "homepage": "https://github.com/fangqiuci/feiyu-brain#readme",
  "bugs": {
    "url": "https://github.com/fangqiuci/feiyu-brain/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "main": "./lib/dsh-plugin.mjs",
  "exports": {
    ".": "./lib/dsh-plugin.mjs",
    "./lib": "./lib/dsh-plugin.mjs",
    "./adapters": "./adapters/index.js",
    "./adapters/qq-bridge": "./adapters/qq-bridge.js",
    "./adapters/tencent-official": "./adapters/tencent-official.js",
    "./adapters/universal": "./adapters/universal.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "feiyu": "./cli.mjs"
  },
  "files": [
    "index.js",
    "store.js",
    "cli.mjs",
    "demo.mjs",
    "selftest.mjs",
    "test-adapters.mjs",
    "smoke.mjs",
    "cordis.patch.yml",
    "core/",
    "adapters/",
    "lib/",
    "docs/",
    "examples/",
    "market/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "llm",
    "agent",
    "persona",
    "memory",
    "brain",
    "qq-bot",
    "tencent-qq",
    "chatbot",
    "onebot",
    "qq",
    "snowluma",
    "napcat",
    "lagrange"
  ],
  "scripts": {
    "test": "node selftest.mjs && node test-adapters.mjs",
    "demo": "node demo.mjs",
    "smoke": "node smoke.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
